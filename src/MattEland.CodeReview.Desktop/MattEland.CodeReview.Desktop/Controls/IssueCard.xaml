<UserControl x:Class="MattEland.CodeReview.Desktop.Controls.IssueCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MattEland.CodeReview.Desktop.Controls"
             xmlns:models="using:MattEland.CodeReview.Core.Models"
             xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
            CornerRadius="6"
            Padding="0">
        
        <muxc:Expander HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Stretch"
                       ExpandDirection="Down"
                       IsExpanded="False">
            <muxc:Expander.Header>
                <Grid Padding="4,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Severity Dot -->
                        <ColumnDefinition Width="Auto"/> <!-- Rule ID -->
                        <ColumnDefinition Width="Auto"/> <!-- Line Number -->
                        <ColumnDefinition Width="*"/>    <!-- Message -->
                        <ColumnDefinition Width="Auto"/> <!-- Severity Badge -->
                    </Grid.ColumnDefinitions>

                    <!-- Severity Indicator -->
                    <Border Grid.Column="0"
                            Width="6" Height="6"
                            CornerRadius="3"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <Border.Background>
                            <SolidColorBrush x:Name="SeverityBrush"/>
                        </Border.Background>
                    </Border>

                    <!-- Rule ID -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource ControlFillColorTertiaryBrush}"
                            CornerRadius="3"
                            Padding="6,2"
                            Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind Issue.RuleId, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>

                    <!-- Line Number -->
                    <Border Grid.Column="2"
                            Background="{ThemeResource ControlFillColorTertiaryBrush}"
                            CornerRadius="3"
                            Padding="6,2"
                            Margin="0,0,12,0"
                            Visibility="{x:Bind local:IssueCard.HasLine(Issue.StartLine), Mode=OneWay}">
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                   FontFamily="Consolas"
                                   FontSize="11">
                            <Run Text="Ln"/>
                            <Run Text="{x:Bind Issue.StartLine, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <!-- Message -->
                    <TextBlock Grid.Column="3"
                               Text="{x:Bind Issue.Message, Mode=OneWay}"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <!-- Severity Badge -->
                    <Border Grid.Column="4"
                            CornerRadius="4"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush x:Name="SeverityBackgroundBrush"/>
                        </Border.Background>
                        <TextBlock x:Name="SeverityText"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="SeverityTextBrush"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                </Grid>
            </muxc:Expander.Header>

            <muxc:Expander.Content>
                <StackPanel Spacing="12" Padding="8,8,8,4">
                    
                    <!-- Full Message -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Message"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind Issue.Message, Mode=OneWay}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   TextWrapping="WrapWholeWords"/>
                    </StackPanel>

                    <!-- Suggestion -->
                    <StackPanel Spacing="4" 
                                Visibility="{x:Bind local:IssueCard.HasText(Issue.Suggestion), Mode=OneWay}">
                        <TextBlock Text="Suggestion"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="4"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" 
                                          FontSize="14"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="{x:Bind Issue.Suggestion, Mode=OneWay}"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Code Snippet -->
                    <StackPanel Spacing="8" 
                                Visibility="{x:Bind local:IssueCard.HasText(Issue.CodeSnippet), Mode=OneWay}">
                        <TextBlock Text="Code Context"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontWeight="SemiBold"/>
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16,12">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                          VerticalScrollBarVisibility="Disabled">
                                <TextBlock Text="{x:Bind Issue.CodeSnippet, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           LineHeight="20"
                                           TextWrapping="NoWrap"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Explanation -->
                    <StackPanel Spacing="4" 
                                Visibility="{x:Bind local:IssueCard.HasText(Issue.Explanation), Mode=OneWay}">
                        <TextBlock Text="Explanation"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind Issue.Explanation, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords"/>
                    </StackPanel>

                    <!-- Metadata -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                            <Run Text="Rule:"/>
                            <Run Text="{x:Bind Issue.RuleId, Mode=OneWay}" FontFamily="Consolas"/>
                        </TextBlock>

                        <TextBlock Grid.Column="1"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{x:Bind local:IssueCard.HasConfidence(Issue.Confidence), Mode=OneWay}">
                            <Run Text="Confidence:"/>
                            <Run Text="{x:Bind local:IssueCard.FormatConfidence(Issue.Confidence), Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>

                </StackPanel>
            </muxc:Expander.Content>
        </muxc:Expander>
    </Border>
</UserControl>
