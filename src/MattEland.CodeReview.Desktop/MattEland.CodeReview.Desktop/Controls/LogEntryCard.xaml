<UserControl x:Class="MattEland.CodeReview.Desktop.Controls.LogEntryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MattEland.CodeReview.Desktop.Controls"
             xmlns:vm="using:MattEland.CodeReview.Desktop.ViewModels"
             xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
            CornerRadius="6"
            Padding="0">
        
        <Grid>
            <!-- Simple entry (no details) -->
            <Grid Padding="12,8" ColumnSpacing="12"
                  Visibility="{x:Bind local:LogEntryCard.Not(LogEntry.HasDetails), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Timestamp -->
                <TextBlock Grid.Column="0"
                           Text="{x:Bind local:LogEntryCard.FormatTime(LogEntry.Timestamp), Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           Width="60"/>

                <!-- Level Icon -->
                <FontIcon Grid.Column="1"
                          Glyph="{x:Bind local:LogEntryCard.GetLevelIcon(LogEntry.Level), Mode=OneWay}"
                          FontSize="14"
                          VerticalAlignment="Center">
                    <FontIcon.Foreground>
                        <SolidColorBrush Color="{x:Bind local:LogEntryCard.GetLevelColor(LogEntry.Level), Mode=OneWay}"/>
                    </FontIcon.Foreground>
                </FontIcon>

                <!-- Message -->
                <TextBlock Grid.Column="2"
                           Text="{x:Bind LogEntry.Message, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="WrapWholeWords"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Expandable entry (has details) -->
            <muxc:Expander HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           ExpandDirection="Down"
                           IsExpanded="False"
                           Visibility="{x:Bind local:LogEntryCard.VisibleIf(LogEntry.HasDetails), Mode=OneWay}">
                <muxc:Expander.Header>
                    <Grid Padding="4,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Timestamp -->
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind local:LogEntryCard.FormatTime(LogEntry.Timestamp), Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"
                                   Width="60"/>

                        <!-- Level Icon -->
                        <FontIcon Grid.Column="1"
                                  Glyph="{x:Bind local:LogEntryCard.GetLevelIcon(LogEntry.Level), Mode=OneWay}"
                                  FontSize="14"
                                  VerticalAlignment="Center">
                            <FontIcon.Foreground>
                                <SolidColorBrush Color="{x:Bind local:LogEntryCard.GetLevelColor(LogEntry.Level), Mode=OneWay}"/>
                            </FontIcon.Foreground>
                        </FontIcon>

                        <!-- Message -->
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind LogEntry.Message, Mode=OneWay}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <!-- File/Rule Badge -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource ControlFillColorTertiaryBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind local:LogEntryCard.HasText(LogEntry.RuleId), Mode=OneWay}">
                                <TextBlock Text="{x:Bind LogEntry.RuleId, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </muxc:Expander.Header>

                <muxc:Expander.Content>
                    <StackPanel Spacing="12" Padding="12,8">
                        
                        <!-- File Path -->
                        <StackPanel Spacing="4" 
                                    Visibility="{x:Bind local:LogEntryCard.HasText(LogEntry.FilePath), Mode=OneWay}">
                            <TextBlock Text="File"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind LogEntry.FilePath, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       FontFamily="Consolas"
                                       TextWrapping="WrapWholeWords"/>
                        </StackPanel>

                        <!-- LLM Prompt -->
                        <StackPanel Spacing="4" 
                                    Visibility="{x:Bind local:LogEntryCard.HasText(LogEntry.LlmPrompt), Mode=OneWay}">
                            <TextBlock Text="LLM Prompt"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Border Background="{ThemeResource ControlFillColorTertiaryBrush}"
                                    CornerRadius="4" Padding="12,8">
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{x:Bind LogEntry.LlmPrompt, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               FontFamily="Consolas"
                                               TextWrapping="WrapWholeWords"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- LLM Response -->
                        <StackPanel Spacing="4" 
                                    Visibility="{x:Bind local:LogEntryCard.HasText(LogEntry.LlmResponse), Mode=OneWay}">
                            <TextBlock Text="LLM Response"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="4" Padding="12,8">
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{x:Bind LogEntry.LlmResponse, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               FontFamily="Consolas"
                                               TextWrapping="WrapWholeWords"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </muxc:Expander.Content>
            </muxc:Expander>
        </Grid>
    </Border>
</UserControl>
