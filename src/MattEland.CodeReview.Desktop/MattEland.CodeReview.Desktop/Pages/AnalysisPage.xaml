<Page x:Class="MattEland.CodeReview.Desktop.Pages.AnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MattEland.CodeReview.Desktop.Pages"
      xmlns:vm="using:MattEland.CodeReview.Desktop.ViewModels"
      xmlns:models="using:MattEland.CodeReview.Core.Models"
      xmlns:controls="using:MattEland.CodeReview.Desktop.Controls"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:helpers="using:MattEland.CodeReview.Desktop.Pages"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="CompactTreeViewItemStyle" TargetType="muxc:TreeViewItem">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid RowSpacing="16" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Compact Wizard Header (Hidden during analysis) -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,10"
                Visibility="{x:Bind helpers:AnalysisPage.VisibleIfNotStep(Wizard.CurrentStep, 3), Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Title + Step Info -->
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Code Analysis" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center">
                            <Run Text="Step"/>
                            <Run Text="{x:Bind Wizard.CurrentStepIndex, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="of 4"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Step Indicator (compact) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16">
                    <!-- Step 1 -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{x:Bind helpers:AnalysisPage.GetStepOpacity(Wizard.CurrentStep, 0), Mode=OneWay}">
                        <Border Width="20" Height="20" CornerRadius="10" Background="{ThemeResource SystemAccentColor}">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Repository" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                    <!-- Step 2 -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{x:Bind helpers:AnalysisPage.GetStepOpacity(Wizard.CurrentStep, 1), Mode=OneWay}">
                        <Border Width="20" Height="20" CornerRadius="10" Background="{x:Bind helpers:AnalysisPage.GetStepBackground(Wizard.CurrentStep, 1), Mode=OneWay}">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Files" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                    <!-- Step 3 -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{x:Bind helpers:AnalysisPage.GetStepOpacity(Wizard.CurrentStep, 2), Mode=OneWay}">
                        <Border Width="20" Height="20" CornerRadius="10" Background="{x:Bind helpers:AnalysisPage.GetStepBackground(Wizard.CurrentStep, 2), Mode=OneWay}">
                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Rules" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                    <!-- Step 4 -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{x:Bind helpers:AnalysisPage.GetStepOpacity(Wizard.CurrentStep, 3), Mode=OneWay}">
                        <Border Width="20" Height="20" CornerRadius="10" Background="{x:Bind helpers:AnalysisPage.GetStepBackground(Wizard.CurrentStep, 3), Mode=OneWay}">
                            <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Results" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Step Content Area -->
        <Grid Grid.Row="2">
            
            <!-- Step 1: Repository Selection -->
            <Grid Visibility="{x:Bind helpers:AnalysisPage.VisibleIfStep(Wizard.CurrentStep, 0), Mode=OneWay}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24" MaxWidth="500">
                    <FontIcon Glyph="&#xE8F1;" FontSize="64" Foreground="{ThemeResource SystemAccentColor}"/>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Analyze Your Code" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a base branch to compare your current changes against." 
                                   Style="{ThemeResource BodyTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>

                    <muxc:InfoBar IsOpen="{x:Bind Wizard.IsBusy, Mode=OneWay}"
                                  Severity="Informational"
                                  Title="Detecting Repository"
                                  Message="Please wait while we check for a repository..."
                                  IsClosable="False"/>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="24"
                            Visibility="{x:Bind Wizard.HasRepository, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Current Repository" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind Wizard.RepositoryDisplayName, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{x:Bind Wizard.RepositoryPath, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7"/>
                            </StackPanel>
                            
                            <StackPanel Spacing="4">
                                <TextBlock Text="Base Branch" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox Text="{x:Bind Wizard.BaseBranch, Mode=TwoWay}" PlaceholderText="main"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- No Repository Selected State -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="32"
                            Visibility="{x:Bind helpers:AnalysisPage.Not(Wizard.HasRepository), Mode=OneWay}">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="No repository open" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Open a repository from the Home page to start an analysis." 
                                       Style="{ThemeResource BodyTextBlockStyle}" HorizontalAlignment="Center"/>
                            <Button HorizontalAlignment="Center" Margin="0,12,0,0"
                                    Command="{Binding ViewModel.RequestNavigateToHomeCommand, ElementName=PageRoot}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE80F;" FontSize="14"/>
                                    <TextBlock Text="Go to Home"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <muxc:ProgressRing IsActive="{x:Bind Wizard.IsFetchingChanges, Mode=OneWay}" Width="32" Height="32"/>
                </StackPanel>
            </Grid>

            <!-- Step 2: File Selection -->
            <Grid Visibility="{x:Bind helpers:AnalysisPage.VisibleIfStep(Wizard.CurrentStep, 1), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Select Files to Analyze" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind Wizard.SelectedFileCount, Mode=OneWay}"/>
                            <Run Text="of"/>
                            <Run Text="{x:Bind Wizard.Files.Count, Mode=OneWay}"/>
                            <Run Text="files selected"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <muxc:AutoSuggestBox PlaceholderText="Search files..." Width="180"
                                              Text="{x:Bind Wizard.FileFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              QueryIcon="Find"/>
                        <Button Content="Select All" Command="{x:Bind Wizard.SelectAllFilesCommand}"/>
                        <Button Content="Deselect All" Command="{x:Bind Wizard.DeselectAllFilesCommand}"/>
                        <Button Content="Invert" Command="{x:Bind Wizard.InvertFileSelectionCommand}" ToolTipService.ToolTip="Invert file selection"/>
                    </StackPanel>
                </Grid>

                <!-- Summary Bar -->
                <Border Grid.Row="1" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                        CornerRadius="6" Padding="16,8" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="+" Foreground="#6BCB77" FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind Wizard.TotalLinesAdded, Mode=OneWay}" Foreground="#6BCB77"/>
                            <TextBlock Text="lines" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="-" Foreground="#FF6B6B" FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind Wizard.TotalLinesDeleted, Mode=OneWay}" Foreground="#FF6B6B"/>
                            <TextBlock Text="lines" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="0,0,12,0">
                    <muxc:TreeView ItemsSource="{x:Bind Wizard.FilteredFileNodes, Mode=OneWay}" SelectionMode="None">
                        <muxc:TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SelectableFileTreeNode">
                                <muxc:TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="True" 
                                                    Style="{StaticResource CompactTreeViewItemStyle}">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="18" Padding="0"/>
                                        
                                        <!-- Folder Icon -->
                                        <FontIcon Grid.Column="1" Glyph="&#xED25;" FontSize="12" VerticalAlignment="Center" 
                                                  Visibility="{x:Bind helpers:AnalysisPage.Not(IsFile), Mode=OneWay}" Opacity="0.7"/>
                                        
                                        <!-- File Icon -->
                                        <FontIcon Grid.Column="1" Glyph="{x:Bind helpers:AnalysisPage.GetChangeTypeIcon(FileViewModel.ChangeType), Mode=OneWay}" 
                                                  FontSize="12" VerticalAlignment="Center" Visibility="{x:Bind IsFile, Mode=OneWay}">
                                            <FontIcon.Foreground>
                                                <SolidColorBrush Color="{x:Bind helpers:AnalysisPage.GetChangeTypeColor(FileViewModel.ChangeType), Mode=OneWay}"/>
                                            </FontIcon.Foreground>
                                        </FontIcon>

                                        <TextBlock Grid.Column="2" Text="{x:Bind Name}" VerticalAlignment="Center" FontSize="12"/>

                                        <TextBlock Grid.Column="3" Text="{x:Bind helpers:AnalysisPage.FormatLineChanges(FileViewModel.LinesAdded, FileViewModel.LinesDeleted), Mode=OneWay}" 
                                                   VerticalAlignment="Center" FontSize="10" Opacity="0.5" Margin="4,0,0,0"
                                                   Visibility="{x:Bind IsFile, Mode=OneWay}"/>
                                    </Grid>
                                </muxc:TreeViewItem>
                            </DataTemplate>
                        </muxc:TreeView.ItemTemplate>
                    </muxc:TreeView>
                </Border>
            </Grid>

            <!-- Step 3: Rule Selection -->
            <Grid Visibility="{x:Bind helpers:AnalysisPage.VisibleIfStep(Wizard.CurrentStep, 2), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Select Rules to Apply" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind Wizard.SelectedRuleCount, Mode=OneWay}"/>
                            <Run Text="of"/>
                            <Run Text="{x:Bind Wizard.Rules.Count, Mode=OneWay}"/>
                            <Run Text="available rules selected"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Select All" Command="{x:Bind Wizard.SelectAllRulesCommand}"/>
                        <Button Content="Deselect All" Command="{x:Bind Wizard.DeselectAllRulesCommand}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <ListView ItemsSource="{x:Bind Wizard.Rules, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SelectableRuleViewModel">
                                <Grid Padding="12,8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Width="4" Height="32" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{ThemeResource SystemAccentColor}"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind Language}" Style="{ThemeResource CaptionTextBlockStyle}" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{x:Bind SeverityDisplay}" VerticalAlignment="Center" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- Step 4: Analysis & Results -->
            <Grid Visibility="{x:Bind helpers:AnalysisPage.VisibleIfStep(Wizard.CurrentStep, 3), Mode=OneWay}" Margin="0,-40,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Results Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Title Row -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Analysis Results" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{x:Bind Wizard.ResetCommand}" ToolTipService.ToolTip="Start a new analysis">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="New Analysis"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Analysis Progress Bar (shown during analysis) -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" 
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="6" Padding="16,12" Margin="0,12,0,0"
                            Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <muxc:ProgressRing IsActive="True" Width="24" Height="24" VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentFileName, Mode=OneWay}" 
                                               Style="{ThemeResource BodyTextBlockStyle}" 
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.CompletedWorkItems, Mode=OneWay}" FontWeight="Bold"/>
                                        <TextBlock Text="of" Opacity="0.7"/>
                                        <TextBlock Text="{x:Bind ViewModel.TotalWorkItems, Mode=OneWay}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                                <muxc:ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" 
                                                   Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                                                   IsIndeterminate="False"/>
                            </StackPanel>
                            
                            <Button Grid.Column="3" Content="Cancel" 
                                    Command="{x:Bind ViewModel.CancelAnalysisCommand}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar: File Tree -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <FontIcon Glyph="&#xED25;" FontSize="14"/>
                                <TextBlock Text="Files" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>

                            <muxc:TreeView Grid.Row="1" 
                                           ItemsSource="{x:Bind ViewModel.FileTreeNodes, Mode=OneWay}"
                                           SelectionMode="None">
                                <muxc:TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileTreeNode">
                                        <muxc:TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="True">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                 <FontIcon Grid.Column="0" Glyph="{x:Bind helpers:AnalysisPage.GetNodeIcon(IsFile)}" FontSize="12" Opacity="0.7"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                                <Border Grid.Column="2" Background="#442726" CornerRadius="8" Padding="5,1"
                                                        Visibility="{x:Bind helpers:AnalysisPage.VisibleIfPositive(IssueCount), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind IssueCount, Mode=OneWay}" FontSize="10" Foreground="#FF6B6B"/>
                                                </Border>
                                                <FontIcon Grid.Column="3" Glyph="{x:Bind helpers:AnalysisPage.GetStatusIcon(Status), Mode=OneWay}" FontSize="12">
                                                    <FontIcon.Foreground>
                                                        <SolidColorBrush Color="{x:Bind helpers:AnalysisPage.GetStatusColor(Status), Mode=OneWay}"/>
                                                    </FontIcon.Foreground>
                                                </FontIcon>
                                            </Grid>
                                        </muxc:TreeViewItem>
                                    </DataTemplate>
                                </muxc:TreeView.ItemTemplate>
                            </muxc:TreeView>
                        </Grid>
                    </Border>

                    <!-- Main Results TabView -->
                    <muxc:TabView Grid.Column="1" 
                                   SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}"
                                   IsAddTabButtonVisible="False" TabWidthMode="Equal">
                        <muxc:TabView.TabItems>
                            <muxc:TabViewItem Header="Activity Log" IsClosable="False">
                                <Grid Padding="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <muxc:ItemsRepeater ItemsSource="{x:Bind ViewModel.AnalysisLog, Mode=OneWay}">
                                            <muxc:ItemsRepeater.Layout>
                                                <muxc:StackLayout Spacing="8"/>
                                            </muxc:ItemsRepeater.Layout>
                                            <muxc:ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AnalysisLogEntry">
                                                    <controls:LogEntryCard LogEntry="{x:Bind}"/>
                                                </DataTemplate>
                                            </muxc:ItemsRepeater.ItemTemplate>
                                        </muxc:ItemsRepeater>
                                    </ScrollViewer>
                                </Grid>
                            </muxc:TabViewItem>

                            <muxc:TabViewItem Header="Results" IsClosable="False">
                                <Grid Padding="4,4,4,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Summary & Filter Bar -->
                                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8" 
                                                Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="24">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xEA39;" Foreground="#FF6B6B" FontSize="14"/>
                                                <TextBlock Text="{x:Bind ViewModel.TotalIssues, Mode=OneWay}" FontWeight="Bold"/>
                                                <TextBlock Text="Issues Found"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="All" Command="{x:Bind ViewModel.ClearSeverityFilterCommand}"/>
                                            <Button Command="{x:Bind ViewModel.SetSeverityFilterCommand}" CommandParameter="{x:Bind models:Severity.Critical}">
                                                <Ellipse Width="8" Height="8" Fill="#FF6B6B"/>
                                            </Button>
                                            <Button Command="{x:Bind ViewModel.SetSeverityFilterCommand}" CommandParameter="{x:Bind models:Severity.Error}">
                                                <Ellipse Width="8" Height="8" Fill="#FFB366"/>
                                            </Button>
                                            <Button Command="{x:Bind ViewModel.SetSeverityFilterCommand}" CommandParameter="{x:Bind models:Severity.Warning}">
                                                <Ellipse Width="8" Height="8" Fill="#6BCB77"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <muxc:ItemsRepeater ItemsSource="{x:Bind ViewModel.GroupedIssues, Mode=OneWay}">
                                            <muxc:ItemsRepeater.Layout>
                                                <muxc:StackLayout Spacing="4"/>
                                            </muxc:ItemsRepeater.Layout>
                                            <muxc:ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FileIssueGroup">
                                                    <muxc:Expander HorizontalAlignment="Stretch" IsExpanded="True" Padding="0">
                                                        <muxc:Expander.Header>
                                                            <TextBlock Text="{x:Bind FileName}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                                        </muxc:Expander.Header>
                                                        <muxc:ItemsRepeater ItemsSource="{x:Bind Issues}" Margin="4,2,4,4">
                                                            <muxc:ItemsRepeater.Layout>
                                                                <muxc:StackLayout Spacing="4"/>
                                                            </muxc:ItemsRepeater.Layout>
                                                            <muxc:ItemsRepeater.ItemTemplate>
                                                                <DataTemplate x:DataType="models:Issue">
                                                                    <controls:IssueCard Issue="{x:Bind}"/>
                                                                </DataTemplate>
                                                            </muxc:ItemsRepeater.ItemTemplate>
                                                        </muxc:ItemsRepeater>
                                                    </muxc:Expander>
                                                </DataTemplate>
                                            </muxc:ItemsRepeater.ItemTemplate>
                                        </muxc:ItemsRepeater>
                                    </ScrollViewer>
                                </Grid>
                            </muxc:TabViewItem>
                        </muxc:TabView.TabItems>
                    </muxc:TabView>
                </Grid>
            </Grid>
        </Grid>

        <!-- Wizard Navigation Controls (Hidden during analysis) -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Margin="-24,16,-24,-24" Padding="24"
                Visibility="{x:Bind helpers:AnalysisPage.VisibleIfNotStep(Wizard.CurrentStep, 3), Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{x:Bind Wizard.BackCommand}" IsEnabled="{x:Bind Wizard.CanGoBack, Mode=OneWay}" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                        <TextBlock Text="Previous"/>
                    </StackPanel>
                </Button>

                <muxc:InfoBar Grid.Column="1" Margin="12,0" IsOpen="{x:Bind Wizard.HasError, Mode=OneWay}"
                               Severity="Error" Title="Error" Message="{x:Bind Wizard.ErrorMessage, Mode=OneWay}" IsClosable="False"/>

                <Button Grid.Column="2" Click="OnNextClicked" Style="{ThemeResource AccentButtonStyle}" 
                        IsEnabled="{x:Bind Wizard.CanGoNext, Mode=OneWay}" Padding="24,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Wizard.NextButtonText, Mode=OneWay}"/>
                        <FontIcon Glyph="&#xE72A;" FontSize="14"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
