<Page x:Class="MattEland.CodeReview.Desktop.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MattEland.CodeReview.Desktop.Pages"
      xmlns:vm="using:MattEland.CodeReview.Desktop.ViewModels"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="0,0,0,24">
            
            <!-- Welcome Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="Code Review Tool" 
                           Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                <TextBlock Text="LLM-powered code review that detects logic errors, performance issues, and security vulnerabilities."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="WrapWholeWords"/>
            </StackPanel>

            <!-- Quick Actions -->
            <StackPanel Spacing="12">
                <TextBlock Text="Get Started" 
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="400"/>
                        <ColumnDefinition Width="*" MaxWidth="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- Open Repository Card -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{ThemeResource SystemAccentColorLight2}"
                                        CornerRadius="8"
                                        Padding="12">
                                    <FontIcon Glyph="&#xED25;" 
                                              FontSize="24"
                                              Foreground="{ThemeResource SystemAccentColor}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Open Repository"
                                               Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                    <TextBlock Text="Browse for a git repository"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Browse..." 
                                    Command="{x:Bind ViewModel.BrowseForRepositoryCommand}"
                                    HorizontalAlignment="Stretch"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Current Repository Card -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Visibility="{x:Bind ViewModel.HasRepository, Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        CornerRadius="8"
                                        Padding="12">
                                    <FontIcon Glyph="&#xE8B7;" 
                                              FontSize="24"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.RepositoryDisplayName, Mode=OneWay}"
                                               Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8AD;" FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentBranch, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.RepositoryPath, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Command="{x:Bind ViewModel.NavigateToAnalysisCommand}"
                                    HorizontalAlignment="Stretch"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="16"/>
                                    <TextBlock Text="Analyze"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Stats Cards -->
            <StackPanel Spacing="12">
                <TextBlock Text="Statistics" 
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="200"/>
                        <ColumnDefinition Width="*" MaxWidth="200"/>
                        <ColumnDefinition Width="*" MaxWidth="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Rules -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.TotalRules, Mode=OneWay}"
                                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                                       Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock Text="Total Rules"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Enabled Rules -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.EnabledRules, Mode=OneWay}"
                                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="Enabled Rules"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Languages -->
                    <Border Grid.Column="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.SupportedLanguages, Mode=OneWay}"
                                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorAttentionBrush}"/>
                            <TextBlock Text="Languages"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Recent Repositories -->
            <StackPanel Spacing="12">
                <TextBlock Text="Recent Repositories" 
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>

                <muxc:ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentRepositories, Mode=OneWay}">
                    <muxc:ItemsRepeater.Layout>
                        <muxc:StackLayout Spacing="8"/>
                    </muxc:ItemsRepeater.Layout>
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentRepository">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" 
                                              Glyph="&#xE8B7;"
                                              FontSize="20"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind Path}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" 
                                                Orientation="Horizontal" 
                                                Spacing="8">
                                        <Button Content="Open"
                                                Command="{Binding DataContext.OpenRepositoryCommand, ElementName=PageRoot}"
                                                CommandParameter="{x:Bind Path}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>

                <!-- Empty state -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="32"
                        Visibility="{x:Bind local:HomePage.IsEmpty(ViewModel.RecentRepositories.Count), Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE838;" 
                                  FontSize="32"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="No recent repositories"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Open a repository to get started"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
